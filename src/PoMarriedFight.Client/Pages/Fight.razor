@page "/2p"
@page "/fight"
@inject IApiClient Api
@inject NavigationManager Nav

<PageTitle>2P · PoFightJudge</PageTitle>

<PageShell Width="PageShell.ShellWidth.Standard" Eyebrow="Channel 2P" Title="2P"
           Lead="The two of you, one microphone, and a judge who hosts the argument, questions you both and rules at the end. Your initials are your record: whoever has argued here before is remembered by them.">
    <ChildContent>
        <div class="setup">
            <section class="tags">
                <FighterTagInput Label="Fighter one" Name="player1Tag" Tag="@_one" TagChanged="@OnOneChanged" Known="@_known" Excluded="@_two" />
                <FighterTagInput Label="Fighter two" Name="player2Tag" Tag="@_two" TagChanged="@OnTwoChanged" Known="@_known" Excluded="@_one" />
            </section>

            <section class="preview" aria-label="Who is arguing">
                <FighterCard Tag="@_one" Fighter="@Known(_one)" />
                <div class="versus po-display" aria-hidden="true">vs</div>
                <FighterCard Tag="@_two" Fighter="@Known(_two)" IsSecond="true" />
            </section>

            <section class="topic">
                <RadzenFormField Text="What are you arguing about?" Variant="Variant.Outlined">
                    <ChildContent>
                        <RadzenTextBox Value="@_topic" @oninput="@OnTopicTyped" Name="topic" MaxLength="200" Placeholder="who does the dishes" />
                    </ChildContent>
                    <Helper><span class="po-muted">Leave it blank and the host will ask you both at the top of the show.</span></Helper>
                </RadzenFormField>
            </section>

            <HostPersonaPicker Persona="@_persona" PersonaChanged="@(p => _persona = p)" />

            @if (Problem is { Length: > 0 })
            {
                <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="problem">@Problem</RadzenAlert>
            }

            @if (_error is not null)
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="problem">@_error</RadzenAlert>
            }

            <div class="go">
                <RadzenButton Text="@(_starting ? "Starting…" : "Start the fight")" Icon="mic"
                              ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Large"
                              Disabled="@(Problem is not null || _starting)" Click="@StartAsync" />
            </div>

            <p class="po-muted note">The microphone only opens once you press start, and it closes when the fight ends.</p>
        </div>
    </ChildContent>
</PageShell>

@code {
    private IReadOnlyList<FighterDto> _known = [];
    private string _one = string.Empty;
    private string _two = string.Empty;
    private string _topic = string.Empty;
    private HostPersonaId _persona = HostPersonaId.Referee;
    private bool _starting;
    private string? _error;

    /// <summary>Why the fight cannot start yet, or null when it can.</summary>
    private string? Problem =>
        _one.Length == 0 || _two.Length == 0 ? "Both fighters need a tag."
        : string.Equals(_one, _two, StringComparison.OrdinalIgnoreCase) ? "Two people cannot share one tag."
        : null;

    protected override async Task OnInitializedAsync() => _known = await Api.GetFightersAsync();

    private FighterDto? Known(string tag) =>
        tag.Length == 0 ? null : _known.FirstOrDefault(f => string.Equals(f.Tag, tag, StringComparison.OrdinalIgnoreCase));

    private void OnOneChanged(string tag) => _one = tag;

    private void OnTwoChanged(string tag) => _two = tag;

    private void OnTopicTyped(ChangeEventArgs e) => _topic = e.Value?.ToString() ?? string.Empty;

    private async Task StartAsync()
    {
        if (Problem is not null || _starting)
        {
            return;
        }

        _starting = true;
        _error = null;
        try
        {
            var started = await Api.StartFightAsync(new CreateFightRequest(_persona, _one, _two, _topic.Trim() is { Length: > 0 } t ? t : null));
            Nav.NavigateTo($"fight/{started.MatchId.Value}");
        }
        catch (ApiException ex)
        {
            _error = ex.Summary;
        }
        catch (HttpRequestException ex)
        {
            _error = $"The fight could not be started ({ex.Message}).";
        }
        finally
        {
            _starting = false;
        }
    }
}
