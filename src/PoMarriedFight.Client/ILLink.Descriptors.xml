<?xml version="1.0" encoding="utf-8"?>
<!--
  The MessagePack hub protocol resolves DTO members by reflection at runtime, which the trimmer cannot see.
  Rooting the shared contract assembly keeps every hub payload (captions, snapshots, verdicts) serializable
  in a published, trimmed client (deploy.yml publishes with -p:Aot=true, which turns trimming on).
-->
<linker>
  <assembly fullname="PoMarriedFight.Shared" preserve="all" />
</linker>
