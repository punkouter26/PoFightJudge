@inject HttpClient Http

@if (_show)
{
    <div class="po-fake-banner" role="status" aria-live="polite">
        <RadzenIcon Icon="science" />
        <span>Using fake AI — no Gemini key configured. Matches are exhibitions.</span>
    </div>
}

@code {
    private bool _show;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var flags = await Http.GetFromJsonAsync<FeatureFlagsDto>(ApiRoutes.Features.Url);
            _show = flags?.UseFakeAi == true;
        }
        catch (HttpRequestException)
        {
            // The API is down; the pages will say so in their own words.
        }
    }
}
