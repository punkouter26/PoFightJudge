@inherits LayoutComponentBase
@using PoFightJudge.Client.Components
@inject HttpClient Http
@inject NavigationManager Nav

<div class="shell">
    <FakeAiBanner />
    <ConnectionBanner />
    <header class="topbar">
        <a class="brand" href="">
            <span class="mark" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2L4 14h6l-1 8 9-12h-6z"></path></svg>
            </span>
            <span class="wordmark">PoFight <em>Judge</em></span>
        </a>
        <nav class="nav" aria-label="Primary">
            <RadzenMenu Responsive="true">
                <RadzenMenuItem Text="Home" Path="" Icon="home" />
                <RadzenMenuItem Text="CPU" Path="cpu" Icon="theaters" />
                <RadzenMenuItem Text="1P" Path="1p" Icon="record_voice_over" />
                <RadzenMenuItem Text="2P" Path="2p" Icon="mic" />
                <RadzenMenuItem Text="Profiles" Path="profiles" Icon="groups" />
                <RadzenMenuItem Text="Fighters" Path="fighters" Icon="person" />
                <RadzenMenuItem Text="History" Path="history" Icon="history" />
                <RadzenMenuItem Text="Leaderboard" Path="leaderboard" Icon="leaderboard" />
            </RadzenMenu>
        </nav>
        <div class="session">
            <AuthorizeView>
                <Authorized>
                    <span class="user"><RadzenIcon Icon="person" /> @context.User.Identity?.Name</span>
                    <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Icon="logout" Click="SignOutAsync"
                                  aria-label="Sign out" title="Sign out" Disabled="@_signingOut" />
                </Authorized>
            </AuthorizeView>
            <ThemeToggle />
        </div>
    </header>
    <main class="content" id="main">
        @* One unhandled render exception used to drop the whole app to index.html's error strip, which offers a
           reload and loses whatever was in progress. The boundary keeps the shell, the nav and the banner. *@
        <ErrorBoundary @ref="_boundary" @key="_attempt">
            <ChildContent>@Body</ChildContent>
            <ErrorContent>
                <section class="broke po-card" role="alert">
                    <h1 class="po-display">That did not go well</h1>
                    <p>Something on this page stopped working. The rest of the app is fine.</p>
                    <div class="ways">
                        <RadzenButton Text="Try that again" Icon="refresh" ButtonStyle="ButtonStyle.Primary" Click="@Recover" />
                        <RadzenButton Text="Go home" Icon="home" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined"
                                      Click="@(() => GoHome())" />
                    </div>
                </section>
            </ErrorContent>
        </ErrorBoundary>
    </main>
    @* Global keys. Both render nothing until they are asked for, so they cost a listener each. *@
    <CommandPalette />
    <ShortcutSheet />
    <RadzenDialog />
    <RadzenTooltip />
    @* Transient failures surface here; anything that blocks the page stays inline on the page itself. *@
    <RadzenNotification />
</div>

@code {
    private bool _signingOut;

    private ErrorBoundary? _boundary;

    /// <summary>
    /// Bumped on every recovery so the boundary is a new component each time. Recover() alone re-renders the same
    /// children, which throw again immediately if whatever broke them is still there — the key makes it a fresh start.
    /// </summary>
    private int _attempt;

    /// <summary>Navigating away is its own recovery: the boundary is latched until something resets it.</summary>
    protected override void OnParametersSet() => _boundary?.Recover();

    private void Recover()
    {
        _attempt++;
        _boundary?.Recover();
    }

    private void GoHome()
    {
        Recover();
        Nav.NavigateTo("");
    }

    private async Task SignOutAsync()
    {
        if (_signingOut)
        {
            return;
        }

        _signingOut = true;
        try
        {
            // Best-effort: the guest cookie is server-side; the page is the cache we have to clear.
            await Http.PostAsync(new Uri(ApiRoutes.Auth.Logout, UriKind.Relative), null);
        }
        catch (HttpRequestException)
        {
            // The API may be unreachable during a sign-out from a stranded tab; navigate anyway.
        }
        finally
        {
            Nav.NavigateTo(RedirectToLogin.LoginPath, forceLoad: true);
        }
    }
}
