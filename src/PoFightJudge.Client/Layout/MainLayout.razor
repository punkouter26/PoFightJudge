@inherits LayoutComponentBase
@using PoFightJudge.Client.Components
@inject HttpClient Http
@inject NavigationManager Nav
@inject IServiceProvider Services
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication

<div class="shell">
    <FakeAiBanner />
    <ConnectionBanner />
    <header class="topbar">
        <a class="brand" href="">
            <span class="mark" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2L4 14h6l-1 8 9-12h-6z"></path></svg>
            </span>
            <span class="wordmark">PoFight <em>Judge</em></span>
        </a>
        @* The bar above 64rem, a drawer below it. Responsive="false" on both: Radzen's own responsive menu decides
           which to show from JavaScript, after measuring the bar, and until that ran the first paint on a phone had
           every item in flow and a 269 px top bar. Which one is in the document is a media query here, so the
           first frame is already the right one. *@
        <nav class="nav" aria-label="Primary">
            <RadzenMenu Responsive="false">
                @foreach (var place in Destinations)
                {
                    @if (place.Children is null)
                    {
                        @* Home's path is "", which every path starts with: matched as a prefix it was lit on every page. *@
                        <RadzenMenuItem Text="@place.Text" Path="@place.Path" Icon="@place.Icon" Match="@(place.Path.Length == 0 ? NavLinkMatch.All : NavLinkMatch.Prefix)" />
                    }
                    else
                    {
                        @* The three channels are one choice, "play", made three ways: one item on the bar, not three. *@
                        <RadzenMenuItem Text="@place.Text" Icon="@place.Icon">
                            @foreach (var child in place.Children)
                            {
                                <RadzenMenuItem Text="@child.Text" Path="@child.Path" Icon="@child.Icon" />
                            }
                        </RadzenMenuItem>
                    }
                }
            </RadzenMenu>
        </nav>
        <div class="session">
            <RadzenButton class="drawer-toggle" Icon="menu" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text"
                          aria-label="Menu" title="Menu" aria-expanded="@(_drawer ? "true" : "false")" aria-controls="po-drawer"
                          Click="@(() => _drawer = !_drawer)" />
            @* Who you are, the sound, the volume, the theme and the way out: five things nobody needs every minute,
               behind one button rather than five across the bar. *@
            <RadzenButton class="settings-toggle" Icon="tune" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text"
                          aria-label="Settings" title="Settings" aria-expanded="@(_settings ? "true" : "false")" aria-controls="po-settings"
                          Click="@(() => _settings = !_settings)" />
        </div>
    </header>
    @if (_settings)
    {
        <div class="po-settings-scrim" @onclick="@(() => _settings = false)" aria-hidden="true"></div>
        <section class="po-settings po-card" id="po-settings" role="dialog" aria-label="Settings" tabindex="-1"
                 @ref="_settingsPanel" @onkeydown="@OnSettingsKey">
            <AuthorizeView>
                <Authorized>
                    <span class="user"><RadzenIcon Icon="person" /><span class="user-name">@context.User.Identity?.Name</span></span>
                </Authorized>
            </AuthorizeView>
            <div class="setting"><span class="po-eyebrow">Sound</span><SoundToggle /></div>
            <div class="setting"><span class="po-eyebrow">Theme</span><ThemeToggle /></div>
            <div class="setting">
                <span class="po-eyebrow">Stage effects</span>
                <RadzenSwitch Value="@Prefs.Effects" ValueChanged="@((bool on) => Prefs.SetEffectsAsync(on))" Name="effects"
                              InputAttributes="@(new Dictionary<string, object> { ["aria-label"] = "Stage effects" })" />
            </div>
            <div class="setting">
                <span class="po-eyebrow">Spin heat</span>
                <RadzenSelectBar TValue="TopicField.Heat" Value="@Prefs.Heat" ValueChanged="@((TopicField.Heat h) => Prefs.SetHeatAsync(h))"
                                 Size="ButtonSize.Small" Name="heat" aria-label="How spicy a topic">
                    <Items>
                        <RadzenSelectBarItem Text="Mild" Value="@TopicField.Heat.Mild" />
                        <RadzenSelectBarItem Text="Medium" Value="@TopicField.Heat.Medium" />
                        <RadzenSelectBarItem Text="Spicy" Value="@TopicField.Heat.Spicy" />
                    </Items>
                </RadzenSelectBar>
            </div>
            <HostPersonaPicker Persona="@Prefs.Host" PersonaChanged="@((HostPersonaId h) => Prefs.SetHostAsync(h))" />
            <AuthorizeView>
                <Authorized>
                    <RadzenButton Text="Sign out" Icon="logout" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Size="ButtonSize.Small"
                                  Click="SignOutAsync" Disabled="@_signingOut" />
                </Authorized>
            </AuthorizeView>
        </section>
    }
    @* Opened by the toggle above, and closed by anything that leads out of it. Rendered only when it is open, so a
       phone that never asks for the nav never pays for it and a screen reader is never offered a hidden copy of
       every destination. *@
    @if (_drawer)
    {
        @* The scrim is a way out for a mouse; Escape is the way out for a keyboard, and focus starts inside the
           drawer so that Escape has somewhere to be pressed. *@
        <div class="po-drawer-scrim" @onclick="@(() => _drawer = false)" aria-hidden="true"></div>
        <nav class="po-drawer" id="po-drawer" aria-label="Primary" tabindex="-1" @ref="_drawerNav" @onkeydown="@OnDrawerKey">
            <RadzenPanelMenu Click="@(_ => _drawer = false)" AriaLabel="Primary">
                @foreach (var place in Destinations)
                {
                    @if (place.Children is null)
                    {
                        <RadzenPanelMenuItem Text="@place.Text" Path="@place.Path" Icon="@place.Icon" Match="@(place.Path.Length == 0 ? NavLinkMatch.All : NavLinkMatch.Prefix)" />
                    }
                    else
                    {
                        @* Open from the start: the drawer has the room, and a channel is one tap rather than two. *@
                        <RadzenPanelMenuItem Text="@place.Text" Icon="@place.Icon" Expanded="true">
                            @foreach (var child in place.Children)
                            {
                                <RadzenPanelMenuItem Text="@child.Text" Path="@child.Path" Icon="@child.Icon" Match="NavLinkMatch.Prefix" />
                            }
                        </RadzenPanelMenuItem>
                    }
                }
            </RadzenPanelMenu>
        </nav>
    }
    @* While the drawer is open the page behind it is not there, for a keyboard and a screen reader as much as for
       a finger. *@
    <main class="content" id="main" inert="@_drawer">
        @* One unhandled render exception used to drop the whole app to index.html's error strip, which offers a
           reload and loses whatever was in progress. The boundary keeps the shell, the nav and the banner. *@
        <ErrorBoundary @ref="_boundary" @key="_attempt">
            <ChildContent>@Body</ChildContent>
            <ErrorContent>
                <section class="broke po-card" role="alert">
                    <h1 class="po-display">That did not go well</h1>
                    <p>Something on this page stopped working. The rest of the app is fine.</p>
                    <div class="ways">
                        <RadzenButton Text="Try that again" Icon="refresh" ButtonStyle="ButtonStyle.Primary" Click="@Recover" />
                        <RadzenButton Text="Go home" Icon="home" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined"
                                      Click="@(() => GoHome())" />
                    </div>
                </section>
            </ErrorContent>
        </ErrorBoundary>
    </main>
    @* Which build this is, for a screenshot or a bug report. Out of the way, and never in the way of a click. *@
    <span class="build" aria-label="@($"Build {BuildStamp.Version}")">v@(BuildStamp.Version)</span>
    <RadzenDialog />
    <RadzenTooltip />
    @* Transient failures surface here; anything that blocks the page stays inline on the page itself. *@
    <RadzenNotification />
</div>

@code {
    /// <summary>A place in the nav, or a group of them.</summary>
    private sealed record Destination(string Text, string Path, string Icon, Destination[]? Children = null);

    /// <summary>The destinations, written once and rendered twice: as the bar, and as the drawer.</summary>
    private static readonly Destination[] Destinations =
    [
        new("Home", "", "home"),
        new("Play", "", "sports_mma",
        [
            new("CPU", "cpu", "theaters"),
            new("1P", "1p", "record_voice_over"),
            new("2P", "2p", "mic"),
        ]),
        new("Profiles", "profiles", "groups"),
        new("Leaderboard", "fighters", "emoji_events"),
        new("History", "history", "history"),
    ];

    [Inject] private SfxInterop Sound { get; set; } = default!;
    [Inject] private ThemeInterop Theme { get; set; } = default!;
    [Inject] private Preferences Prefs { get; set; } = default!;

    /// <summary>Whether the settings panel is open.</summary>
    private bool _settings;
    private ElementReference _settingsPanel;
    private bool _settingsFocused;

    /// <summary>
    /// The stored sound and theme are applied here, once, rather than by the toggles: those live in a panel that is
    /// only in the document while it is open.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await Sound.InitializeAsync();
        await Theme.InitializeAsync();
        await Prefs.InitializeAsync();
    }

    private void OnSettingsKey(KeyboardEventArgs e)
    {
        if (string.Equals(e.Key, "Escape", StringComparison.Ordinal))
        {
            _settings = false;
        }
    }

    private bool _signingOut;

    /// <summary>Whether the phone's nav drawer is open.</summary>
    private bool _drawer;
    private ElementReference _drawerNav;
    private bool _drawerFocused;

    private void OnDrawerKey(KeyboardEventArgs e)
    {
        if (string.Equals(e.Key, "Escape", StringComparison.Ordinal))
        {
            _drawer = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Once per opening: the drawer takes focus when it appears, so Escape and Tab start from inside it.
        if (_drawer && !_drawerFocused)
        {
            _drawerFocused = true;
            await _drawerNav.FocusAsync();
        }
        else if (!_drawer)
        {
            _drawerFocused = false;
        }

        // The same for the settings panel, so Escape closes it from the first key.
        if (_settings && !_settingsFocused)
        {
            _settingsFocused = true;
            await _settingsPanel.FocusAsync();
        }
        else if (!_settings)
        {
            _settingsFocused = false;
        }
    }

    private ErrorBoundary? _boundary;

    /// <summary>
    /// Bumped on every recovery so the boundary is a new component each time. Recover() alone re-renders the same
    /// children, which throw again immediately if whatever broke them is still there — the key makes it a fresh start.
    /// </summary>
    private int _attempt;

    /// <summary>
    /// Navigating away is its own recovery: the boundary is latched until something resets it. It also closes the
    /// drawer, which covers the case of a destination reached some other way while it was open.
    /// </summary>
    protected override void OnParametersSet()
    {
        _drawer = false;
        _settings = false;
        _boundary?.Recover();
    }

    private void Recover()
    {
        _attempt++;
        _boundary?.Recover();
    }

    private void GoHome()
    {
        Recover();
        Nav.NavigateTo("");
    }

    private async Task SignOutAsync()
    {
        if (_signingOut)
        {
            return;
        }

        _signingOut = true;
        try
        {
            // Best-effort: the guest cookie is server-side; the page is the cache we have to clear.
            await Http.PostAsync(new Uri(ApiRoutes.Auth.Logout, UriKind.Relative), null);
        }
        catch (HttpRequestException)
        {
            // The API may be unreachable during a sign-out from a stranded tab; navigate anyway.
        }
        finally
        {
            // A Microsoft sign-in lives in MSAL's cache as well; ending only the cookie would sign them straight back
            // in. MSAL's logout clears it and comes back to the login page.
            if (Services.GetService(typeof(IAccessTokenProvider)) is IAccessTokenProvider tokens
                && (await tokens.RequestAccessToken()).TryGetToken(out _))
            {
                Nav.NavigateToLogout("authentication/logout", RedirectToLogin.LoginPath);
            }
            else
            {
                Nav.NavigateTo(RedirectToLogin.LoginPath, forceLoad: true);
            }
        }
    }
}
