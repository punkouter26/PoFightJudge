@page "/fighters"
@using System.Globalization
@inject IApiClient Api
@inject NavigationManager Nav

@inject Viewport Viewport
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Leaderboard · PoFightJudge</PageTitle>

<PageShell Width="PageShell.ShellWidth.Standard" Eyebrow="The card" Title="Leaderboard"
           Lead="Who is winning, at the microphone and in the cast. A tag is the person; the name is theirs to change.">
    <Actions>
        <RadzenButton Text="New fight" Icon="mic" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@(() => Nav.NavigateTo("fight"))" />
    </Actions>
    <ChildContent>
        @* A wrapper this page owns, and nothing more (display: contents). Scoped CSS reaches into a child component
           only from an element written here: without one, every ::deep rule for this page matches nothing. *@
        <div class="po-scope">
        @if (_loading)
        {
            <LoadingRows Count="3" Table="true" Label="Reading the card" />
        }
        else if (_error is not null)
        {
            <PageAlert Kind="AlertStyle.Danger">@_error</PageAlert>
        }
        else if (_roster.Count == 0 && _castBoard.Count == 0)
        {
            <EmptyState Icon="sports_mma" Title="Nobody on the card" Text="Fighters are created the first time their tag steps up to the mic.">
                <Action>
                    <RadzenButton Text="Start a fight" Icon="mic" ButtonStyle="ButtonStyle.Primary" Click="@(() => Nav.NavigateTo("fight"))" />
                </Action>
            </EmptyState>
        }
        else
        {
            @* The roster and the standings are two readings of the same people. One below the other they were two
               tables to scroll past; as tabs it is one screen, and both are rendered so either is a click away. *@
            @* The top three by rating, as cards with a foil that catches the light as they turn. *@
            @if (_podium.Count > 0)
            {
                <section class="podium" aria-label="Top of the card">
                    @foreach (var (fighter, index) in _podium.Select((f, i) => (f, i)))
                    {
                        <a href="@($"fighters/{fighter.Tag}")" class="podium-link" aria-label="@($"Number {index + 1}: {fighter.Tag}")">
                            <FoilCard Fighter="@fighter" Rank="@(index + 1)" />
                        </a>
                    }
                </section>
            }

            @* Every "who is winning" in the app, on one page: the people at the microphone and the cast that argues
               on its own, one switch apart. The profiles page used to keep the second one at the foot of its cards. *@
            <RadzenTabs RenderMode="TabRenderMode.Client" class="views">
                <Tabs>
                    <RadzenTabsItem Text="Standings" Icon="leaderboard">
                        <div class="boards">
                            <RadzenSelectBar @bind-Value="_cast" TValue="bool" Size="ButtonSize.Small" aria-label="Whose standings">
                                <Items>
                                    <RadzenSelectBarItem Text="Fighters" Value="false" />
                                    <RadzenSelectBarItem Text="Cast" Value="true" />
                                </Items>
                            </RadzenSelectBar>
                            <p class="po-muted cut-off">Anybody with fewer than @MinimumMatches @(_cast ? "arguments" : "fights") is left off.</p>
                        </div>
                        <Board Rows="@(_cast ? _castBoard : _board)"
                               Empty="@(_cast ? "Nobody in the cast has argued twice yet." : "No one has argued twice on the microphone yet.")" />
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Roster" Icon="groups">
            <div class="find">
                <RadzenFormField Text="Find a fighter" Variant="Variant.Outlined">
                    <ChildContent>
                        <RadzenTextBox Value="@_find" @oninput="@(e => _find = e.Value?.ToString() ?? string.Empty)" Name="find" MaxLength="40"
                                       Placeholder="a tag or a name" aria-label="Find a fighter" />
                    </ChildContent>
                </RadzenFormField>
            </div>
            <RadzenDataGrid Data="@Shown" TItem="FighterStatsDto" AllowSorting="true" AllowPaging="true" PageSize="20" Density="Density.Compact" class="roster"
                            RowClick="@(args => Open(args.Data))" RowRender="@(args => args.Attributes["class"] = "openable")">
                <Columns>
                    @* 5.5 + 6 + 6 + 6 + 9 + 10rem of declared width, before the name column, is 840 px of table. A phone
                       gets the tag, the name, the record and the form in one cell; nothing is dropped, it is stacked. *@
                    <RadzenDataGridColumn TItem="FighterStatsDto" Title="Fighter" Visible="@Viewport.IsPhone" Sortable="false">
                        <Template Context="row">
                            <div class="po-stacked">
                                <span class="po-stacked__head">
                                    <RadzenLink Path="@($"fighters/{row.Tag}")" Text="@row.Tag" class="tag po-display" />
                                    @if (string.Equals(row.DisplayName, row.Tag, StringComparison.Ordinal))
                                    {
                                        <span class="po-muted">no name yet</span>
                                    }
                                    else
                                    {
                                        <span class="po-stacked__strong">@row.DisplayName</span>
                                    }
                                </span>
                                <span class="po-stacked__fine po-muted">
                                    <RankBadge Rating="@row.Rating" Fights="@row.Fights" /> @row.Rating · @row.Wins–@row.Losses@(row.Draws > 0 ? $"–{row.Draws}" : string.Empty) over @row.Fights
                                    @if (row.LastFoughtAt is { } seen)
                                    {
                                        @($" · last {seen.LocalDateTime.ToString("d MMM yyyy", CultureInfo.CurrentCulture)}")
                                    }
                                </span>
                                <FormSparkline Scores="@row.Form" />
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="FighterStatsDto" Title="Tag" Width="5.5rem" Visible="@(!Viewport.IsPhone)" Property="@nameof(FighterStatsDto.Tag)">
                        <Template Context="row"><RadzenLink Path="@($"fighters/{row.Tag}")" Text="@row.Tag" class="tag po-display" /></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="FighterStatsDto" Title="Name" Visible="@(!Viewport.IsPhone)" Property="@nameof(FighterStatsDto.DisplayName)">
                        <Template Context="row">
                            @if (string.Equals(row.DisplayName, row.Tag, StringComparison.Ordinal))
                            {
                                <span class="po-muted">no name yet</span>
                            }
                            else
                            {
                                @row.DisplayName
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="FighterStatsDto" Title="Rating" Width="10rem" Visible="@(!Viewport.IsPhone)" Property="@nameof(FighterStatsDto.Rating)">
                        <Template Context="row">@row.Rating <RankBadge Rating="@row.Rating" Fights="@row.Fights" /></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="FighterStatsDto" Title="Fights" Width="6rem" Visible="@(!Viewport.IsPhone)" Property="@nameof(FighterStatsDto.Fights)" />
                    <RadzenDataGridColumn TItem="FighterStatsDto" Title="W–L" Width="6rem" Visible="@(!Viewport.IsPhone)" Sortable="false">
                        <Template Context="row">@row.Wins–@row.Losses@(row.Draws > 0 ? $"–{row.Draws}" : string.Empty)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="FighterStatsDto" Title="Form" Width="9rem" Visible="@(!Viewport.IsPhone)" Sortable="false">
                        <Template Context="row"><FormSparkline Scores="@row.Form" /></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="FighterStatsDto" Title="Last seen" Width="10rem" Visible="@(!Viewport.IsPhone)" Property="@nameof(FighterStatsDto.LastFoughtAt)">
                        <Template Context="row">
                            @if (row.LastFoughtAt is { } seen)
                            {
                                @seen.LocalDateTime.ToString("d MMM yyyy", CultureInfo.CurrentCulture)
                            }
                            else
                            {
                                <span class="po-muted">never</span>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>

                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
        }
        </div>
    </ChildContent>
</PageShell>

@code {
    private IReadOnlyList<FighterStatsDto> _roster = [];
    private IReadOnlyList<LeaderboardRowDto> _board = [];
    private IReadOnlyList<LeaderboardRowDto> _castBoard = [];

    /// <summary>Whether the standings show the cast (watch results) rather than the fighters.</summary>
    private bool _cast;

    /// <summary>The top three by rating, for the cards above the tabs.</summary>
    private IReadOnlyList<FighterStatsDto> _podium = [];

    private bool _foiled;
    private bool _loading = true;
    private string? _error;
    private string _find = string.Empty;

    /// <summary>The roster, narrowed to whoever's tag or name has what was typed in it. A new list each time: the grid is bound to the instance.</summary>
    private IReadOnlyList<FighterStatsDto> Shown => _find.Trim() is not { Length: > 0 } find
        ? _roster
        : [.. _roster.Where(f => f.Tag.Contains(find, StringComparison.OrdinalIgnoreCase) || f.DisplayName.Contains(find, StringComparison.OrdinalIgnoreCase))];

    /// <summary>The cut-off the server applies, repeated here so the page can explain the gap rather than look wrong.</summary>
    private const int MinimumMatches = 2;

    protected override async Task OnInitializedAsync()
    {
        Viewport.Changed += OnViewportChanged;
        await Viewport.InitializeAsync();
        try
        {
            _roster = await Api.GetRosterAsync();
            _podium = FoilCard.Podium(_roster);
            _board = await Api.GetLeaderboardAsync(MatchMode.Fight);
            _castBoard = await Api.GetLeaderboardAsync(MatchMode.Watch);
        }
        catch (Exception ex) when (ApiFailure.Describe(ex, "The card could not be read") is { } why)
        {
            _error = why;
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>Once the cards are in the page, their foil is set turning. Decoration: a browser that will not, will not.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_foiled || _podium.Count == 0)
        {
            return;
        }

        _foiled = true;
        try
        {
            await JS.InvokeVoidAsync("PoFx.holo", ".foil");
        }
        catch (JSException)
        {
            // Still cards; just still.
        }
    }

    private void Open(FighterStatsDto? row)
    {
        if (row is not null)
        {
            Nav.NavigateTo($"fighters/{row.Tag}");
        }
    }

    /// <summary>Which columns exist is a render decision, and a rotated phone is a different set of them.</summary>
    private void OnViewportChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose() => Viewport.Changed -= OnViewportChanged;
}
