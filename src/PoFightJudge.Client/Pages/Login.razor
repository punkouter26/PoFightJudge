@page "/login"
@attribute [AllowAnonymous]
@layout MainLayout
@inject IApiClient Api
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject Microsoft.AspNetCore.Components.WebAssembly.Hosting.IWebAssemblyHostEnvironment Env
@inject FeatureGate Features

<PageTitle>Sign in · PoFightJudge</PageTitle>

<PageShell Width="PageShell.ShellWidth.Narrow">
    <div class="login po-card">
        <div class="po-eyebrow po-eyebrow--accent">Tonight's card</div>
        <h1>Who's fighting?</h1>
        <p class="po-muted">Sign in to pick a couple to watch, or step up to the mic with your own.</p>

        <div class="buttons">
            @* Production only ever shows the Microsoft button — the prod client is MSAL-driven. *@
            @if (Env.IsProduction())
            {
                <RadzenButton Text="Sign in with Microsoft" Icon="login" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Large"
                              Click="SignInWithMicrosoft" />
            }
            else
            {
                @* Dev: show "Sign in with Microsoft" only when the API has the dev Entra OIDC scheme wired. Otherwise
                       the guest button is the only door, same as before this task. *@
                @if (Features.Flags.DevEntraEnabled)
                {
                    <RadzenButton Text="Sign in with Microsoft" Icon="login" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Large"
                                  Click="SignInWithMicrosoft" />
                }
                @if (Features.Flags.DevGuestEnabled)
                {
                    <RadzenButton Text="Continue as Guest (Dev)" Icon="person" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Large"
                                  Click="ContinueAsGuestAsync" IsBusy="@_busy" BusyText="Signing in…" />
                }
            }
        </div>

        @if (_error is not null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">@_error</RadzenAlert>
        }
        @if (!Env.IsProduction() && Features.Loaded && !Features.Flags.DevGuestEnabled && !Features.Flags.DevEntraEnabled)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">
                Both sign-in doors are off. Set <code>FeatureManagement:DevGuestEnabled</code> for the guest door, or
                <code>PoFightJudge:Auth:AllowDevEntra</code> + <code>PoFightJudge:AzureAd:DevClientId</code> for the Microsoft door.
            </RadzenAlert>
        }
    </div>
</PageShell>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private bool _busy;
    private string? _error;

    /// <summary>
    /// The flags were read at startup, so the buttons are right on the first render. The one case left is a browser
    /// that booted while the API was down: this is the page it lands on, and asking again here is what lets it
    /// recover without a reload.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        if (Features.Loaded)
        {
            return;
        }

        await Features.LoadAsync();
        if (!Features.Loaded)
        {
            _error = "The API is not answering. Is it running?";
        }
    }

    private void SignInWithMicrosoft()
    {
        var returnUrl = Uri.EscapeDataString(SafeReturnUrl());
        if (Env.IsProduction())
        {
            // Production: MSAL handles the code flow on the client.
            Nav.NavigateTo($"authentication/login?returnUrl={returnUrl}");
        }
        else
        {
            // Dev: the BFF cookie scheme on the server runs the code flow. forceLoad:true is required so the
            // browser does a real HTTP request — without it Blazor's router would intercept the navigation and
            // never call the API endpoint.
            Nav.NavigateTo($"auth/login/dev?returnUrl={returnUrl}", forceLoad: true);
        }
    }

    private async Task ContinueAsGuestAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            await Api.GuestSignInAsync();
            (AuthState as ApiAuthStateProvider)?.NotifyChanged();
            Nav.NavigateTo(SafeReturnUrl());
        }
        catch (HttpRequestException)
        {
            _error = "Guest sign-in failed. Is the API running in Development?";
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Only same-origin relative paths are honoured, so a crafted link cannot bounce a user elsewhere.</summary>
    private string SafeReturnUrl() =>
        ReturnUrl is { Length: > 1 } url && url.StartsWith('/') && !url.StartsWith("//", StringComparison.Ordinal) ? url : "/";
}
