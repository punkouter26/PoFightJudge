@page "/watch/play"

<PageTitle>@Headline · PoFightJudge</PageTitle>

<LeaveGuard @ref="_guard" Active="@(_stage is Stage.Arguing or Stage.WaitingForPerson or Stage.Judging && Simulation.IsReady)" />

<PageShell Width="PageShell.ShellWidth.Wide" Eyebrow="Channel 1" Title="@Headline" Lead="@Lead">
    <Actions>
        <RadzenButton Text="Leave" Icon="close" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Click="@Leave" />
    </Actions>
    <ChildContent>
        @if (!Simulation.IsReady)
        {
            <LoadingRows Count="1" Label="Back to the setup" />
        }
        else
        {
            <div class="play">
                <section class="stage" aria-label="The matchup">
                    <div class="corner @(IsSpeaking(WatchTurns.Husband) ? "speaking" : null)">
                        <SpeakerCard Side="@Simulation.Husband" Profile="@ProfileFor(Simulation.Husband)" IsWife="false" />
                    </div>

                    <div class="middle">
                        <InterjectionBar Used="@_slapUsed" Enabled="@(_stage == Stage.Arguing)" Throw="@ThrowAsync" />
                        @if (_isFake)
                        {
                            <span class="po-chip">Rehearsal voices</span>
                        }
                    </div>

                    <div class="corner @(IsSpeaking(WatchTurns.Wife) ? "speaking" : null)">
                        <SpeakerCard Side="@Simulation.Wife" Profile="@ProfileFor(Simulation.Wife)" IsWife="true" />
                    </div>
                </section>

                @* Only while a line is actually being worked out: a person waiting to speak is not the page loading. *@
                @if (_revealedRounds == 0 && _error is null && _stage == Stage.Arguing)
                {
                    <LoadingRows Count="2" Label="Working out how to start" />
                }

                <RadzenTimeline Orientation="Orientation.Vertical" LinePosition="LinePosition.Left" class="transcript" aria-label="The argument so far">
                    <Items>
                        @foreach (var round in _rounds.Take(_revealedRounds))
                        {
                            @* A plain dot in the side's own colour: blue for the husband, red for the wife, matching the card borders. *@
                            <RadzenTimelineItem PointStyle="@(WatchTurns.IsHusband(round.Speaker) ? PointStyle.Info : PointStyle.Danger)">
                                <ChildContent>
                                    <TranscriptLine First="@WatchTurns.IsHusband(round.Speaker)" Speaker="@round.Speaker"
                                                    Name="@NameOf(round.Speaker)" Mood="@round.Mood" Text="@round.Text" />
                                </ChildContent>
                            </RadzenTimelineItem>
                        }
                    </Items>
                </RadzenTimeline>

                @if (_stage == Stage.WaitingForPerson && Person is not null)
                {
                    <section class="your-turn po-card" aria-label="Your turn">
                        <h2>Your turn, @Person.DisplayName</h2>
                        <p class="po-muted">Answer what was just said. It goes on your record under @Person.Id.</p>
                        <RadzenFormField Text="What you say back" Variant="Variant.Outlined" class="say">
                            <ChildContent>
                                @* Published as it is typed: a Say button that stays grey until you click elsewhere reads as broken. *@
                                <RadzenTextArea Value="@_line" @oninput="@OnLineTypedAsync" @onkeydown="@OnLineKeyAsync" Name="line" Rows="3" MaxLength="600"
                                                title="Ctrl+Enter says it"
                                                Placeholder="That is not what I said and you know it." aria-label="What you say back" />
                            </ChildContent>
                        </RadzenFormField>
                        <div class="ways">
                            @if (_recording)
                            {
                                @* The microphone opened with the turn and closes itself on a pause. The meter is
                                   the whole interface: there is nothing here to press. *@
                                <LevelMeter Listening="true" Caption="Listening — just talk" />
                            }
                            else if (_transcribing)
                            {
                                <LevelMeter Listening="false" Caption="Writing it down" />
                            }
                            else
                            {
                                @* Only reached when the automatic path could not finish it — the microphone failed,
                                   nothing was made out, or they started typing. A turn that cannot be spoken still
                                   has to be finishable, so the controls come back for exactly those cases. *@
                                @if (CanRecord)
                                {
                                    <RadzenButton Text="@(_line.Trim().Length == 0 ? "Speak it" : "Speak it again")"
                                                  Icon="mic" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Filled"
                                                  Click="@ListenAgainAsync" />
                                }
                                @* The browser's own recogniser, for anyone who would rather watch the words appear. *@
                                <RadzenSpeechToTextButton Change="@OnDictated" Title="Dictate in the browser" StopTitle="Stop dictating"
                                                          ButtonStyle="ButtonStyle.Base" />
                            }
                        </div>

                        @if (_micProblem is not null)
                        {
                            <PageAlert Kind="AlertStyle.Warning" Class="problem">@_micProblem</PageAlert>
                        }
                        else if (_heardNothing)
                        {
                            <PageAlert Kind="AlertStyle.Info" Class="problem">
                                Nothing was made out in that. Say it again, or type it.
                            </PageAlert>
                        }

                        @if (!_recording && !_transcribing)
                        {
                            <div class="go">
                                <RadzenButton Text="Say it" Icon="record_voice_over" ButtonStyle="ButtonStyle.Primary"
                                              Size="ButtonSize.Large" Disabled="@(_line.Trim().Length == 0)" Click="@SayAsync" />
                            </div>
                        }
                    </section>
                }

                @if (_stage == Stage.Judging)
                {
                    <section class="judging" aria-live="polite">
                        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
                        <span>The judge is reading it back.</span>
                    </section>
                }

                @if (_error is not null)
                {
                    <PageAlert Kind="AlertStyle.Danger" Class="problem">
                        <div class="failure">
                            <span>@_error</span>
                            <RadzenButton Text="@(RetrySeconds > 0 ? $"Try again in {RetrySeconds}s" : "Try again")"
                                          Icon="refresh" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined"
                                          Disabled="@(RetrySeconds > 0)" Click="@RetryAsync" />
                        </div>
                    </PageAlert>
                }

                @if (_verdict is not null)
                {
                    <RulingCard Class="verdict" Winner="@(_verdict.Winner.Length == 0 ? null : NameOfSide(_verdict.Winner))" Summary="@_verdict.Verdict">
                        <div class="scores">
                            <div class="score p1">
                                <span class="po-eyebrow">@Simulation.Husband!.DisplayName</span>
                                <strong class="po-display"><CountUp Value="@_verdict.HusbandScore" /></strong>
                            </div>
                            <div class="score p2">
                                <span class="po-eyebrow">@Simulation.Wife!.DisplayName</span>
                                <strong class="po-display"><CountUp Value="@_verdict.WifeScore" Audible="false" /></strong>
                            </div>
                        </div>
                        <div class="after">
                            <RadzenButton Text="Argue again" Icon="replay" ButtonStyle="ButtonStyle.Primary" Click="@RematchAsync" />
                            <RadzenButton Text="New matchup" Icon="groups" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Click="@Leave" />
                        </div>
                    </RulingCard>
                }
            </div>
        }
    </ChildContent>
</PageShell>
