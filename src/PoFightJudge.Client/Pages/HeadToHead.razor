@page "/vs/{Tag}/{Opponent}"
@using System.Globalization
@using PoFightJudge.Client.Stats
@inject IApiClient Api
@inject NavigationManager Nav
@inject SetupMemory Memory

@inject Viewport Viewport
@implements IDisposable

<PageTitle>@Title · PoFightJudge</PageTitle>

<PageShell Width="PageShell.ShellWidth.Standard" Eyebrow="Head to head" Title="@Title" Lead="@Lead">
    <Actions>
        @if (_h2h is not null)
        {
            <RadzenButton Text="Put them in again" Icon="mic" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Click="@RunItBack" />
        }
    </Actions>
    <ChildContent>
        @if (_loading)
        {
            <LoadingRows Count="2" Label="Counting it up" />
        }
        else if (_h2h is null)
        {
            <EmptyState Icon="person_search" Title="One of them is not on the roster"
                        Text="A tag only exists once somebody has argued under it.">
                <Action>
                    <RadzenButton Text="See the roster" Icon="groups" ButtonStyle="ButtonStyle.Primary" Click="@(() => Nav.NavigateTo("fighters"))" />
                </Action>
            </EmptyState>
        }
        else if (_h2h.NeverMet)
        {
            <EmptyState Icon="sports_mma" Title="They have never argued"
                        Text="@($"{_h2h.DisplayName} and {_h2h.OpponentDisplayName} have both been here, but never against each other.")">
                <Action>
                    <RadzenButton Text="Put them in" Icon="mic" ButtonStyle="ButtonStyle.Primary" Click="@RunItBack" />
                </Action>
            </EmptyState>
        }
        else
        {
            <section class="series po-card" aria-label="The series">
                <div class="corner p1">
                    <span class="name">@_h2h.DisplayName</span>
                    <span class="tally po-display">@_h2h.Wins</span>
                    <span class="po-muted">@StatFormat.Number(_h2h.AverageScore) avg</span>
                </div>
                <div class="middle">
                    <span class="po-eyebrow po-eyebrow--accent">@Standing</span>
                    <span class="po-muted">@_h2h.Meetings @(_h2h.Meetings == 1 ? "meeting" : "meetings")</span>
                    @if (_h2h.Draws > 0)
                    {
                        <span class="po-chip">@_h2h.Draws drawn</span>
                    }
                </div>
                <div class="corner p2">
                    <span class="name">@_h2h.OpponentDisplayName</span>
                    <span class="tally po-display">@_h2h.Losses</span>
                    <span class="po-muted">@StatFormat.Number(_h2h.OpponentAverageScore) avg</span>
                </div>
            </section>

            <h2 class="po-eyebrow">Every time</h2>
            <RadzenDataGrid Data="@_h2h.Recent" TItem="MeetingDto" AllowSorting="true" class="meetings">
                <Columns>
                    @* 33rem of declared width on a 356 px screen. Stacked on a phone, the same five facts. *@
                    <RadzenDataGridColumn TItem="MeetingDto" Title="Meeting" Visible="@Viewport.IsPhone" Sortable="false">
                        <Template Context="meeting">
                            <div class="stacked">
                                <span class="line-1">
                                    <ModeBadge Mode="@meeting.Mode" />
                                    <span class="topic">@meeting.Topic</span>
                                </span>
                                <span class="line-2 po-muted">
                                    @meeting.At.LocalDateTime.ToString("d MMM yyyy", CultureInfo.CurrentCulture)
                                    · @meeting.Score—@meeting.OpponentScore
                                    · @(meeting.IsDraw ? "a draw" : $"{meeting.Winner} took it")
                                </span>
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MeetingDto" Title="When" Width="10rem" Visible="@(!Viewport.IsPhone)" Property="@nameof(MeetingDto.At)">
                        <Template Context="meeting">@meeting.At.LocalDateTime.ToString("d MMM yyyy", CultureInfo.CurrentCulture)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MeetingDto" Title="Kind" Width="8rem" Visible="@(!Viewport.IsPhone)" Sortable="false">
                        <Template Context="meeting"><ModeBadge Mode="@meeting.Mode" /></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MeetingDto" Title="About" Visible="@(!Viewport.IsPhone)" Property="@nameof(MeetingDto.Topic)" />
                    <RadzenDataGridColumn TItem="MeetingDto" Title="Score" Width="8rem" Visible="@(!Viewport.IsPhone)" Sortable="false">
                        <Template Context="meeting">@meeting.Score <span class="po-muted">—</span> @meeting.OpponentScore</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MeetingDto" Title="Took it" Width="8rem" Visible="@(!Viewport.IsPhone)" Sortable="false">
                        <Template Context="meeting">
                            @if (meeting.IsDraw)
                            {
                                <span class="po-muted">Nobody</span>
                            }
                            else
                            {
                                <strong>@meeting.Winner</strong>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>

            @if (_h2h.Meetings > _h2h.Recent.Count)
            {
                <p class="po-muted">Showing the last @_h2h.Recent.Count of @_h2h.Meetings.</p>
            }
        }
    </ChildContent>
</PageShell>

@code {
    private HeadToHeadDto? _h2h;
    private bool _loading = true;

    [Parameter] public string Tag { get; set; } = string.Empty;

    [Parameter] public string Opponent { get; set; } = string.Empty;

    private string Title => _h2h is null ? "Head to head" : $"{_h2h.DisplayName} vs {_h2h.OpponentDisplayName}";

    private string Lead => _h2h is null
        ? "Looking them both up."
        : "Every argument the two of them have had, and how it has gone.";

    /// <summary>The series in one line. Reads as a statement, because it is one.</summary>
    private string Standing => _h2h is null ? string.Empty
        : _h2h.Wins == _h2h.Losses ? "All square"
        : _h2h.IsAhead ? $"{_h2h.DisplayName} leads {_h2h.Wins}–{_h2h.Losses}"
        : $"{_h2h.OpponentDisplayName} leads {_h2h.Losses}–{_h2h.Wins}";

    protected override async Task OnInitializedAsync()
    {
        Viewport.Changed += OnViewportChanged;
        await Viewport.InitializeAsync();
    }

    /// <summary>Which columns exist is a render decision, and a rotated phone is a different set of them.</summary>
    private void OnViewportChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            _h2h = Initials.Normalize(Tag).Length == 0 || Initials.Normalize(Opponent).Length == 0
                ? null
                : await Api.GetHeadToHeadAsync(FighterId.From(Initials.Normalize(Tag)), FighterId.From(Initials.Normalize(Opponent)));
        }
        catch (ApiException)
        {
            _h2h = null;
        }
        catch (HttpRequestException)
        {
            _h2h = null;
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>Arms a 2P setup with the two of them. As everywhere else, it fills the screen in rather than starting.</summary>
    private void RunItBack()
    {
        if (_h2h is null)
        {
            return;
        }

        Memory.Rematch(new FightCard(_h2h.Tag, _h2h.OpponentTag, string.Empty, ProfileRole.Husband, ProfileRole.Wife, HostPersonaId.Referee));
        Nav.NavigateTo("2p");
    }

    public void Dispose() => Viewport.Changed -= OnViewportChanged;
}
