@page "/"
@inject TimeProvider Clock
@inject IApiClient Api
@inject Viewport Viewport
@implements IDisposable

<PageTitle>PoFightJudge</PageTitle>

<PageShell Width="PageShell.ShellWidth.Standard">
    <div class="hero">
        <div class="titles">
            <div class="po-eyebrow">@Clock.GetLocalNow().ToString("dddd · h:mm tt", System.Globalization.CultureInfo.InvariantCulture)</div>
            <h1>What are we fighting about tonight?</h1>
        </div>
        <span class="po-chip po-chip--live">Live</span>
    </div>

    <div class="channels">
        <ChannelCard Number="CPU" Title="CPU vs CPU" Icon="theaters" Href="cpu" Cta="Pick the two" Accent="ChannelCard.ChannelAccent.P1"
                     Short="Two profiles argue; a judge rules. You watch."
                     Description="Two of your profiles argue it out in their own voices, three rounds each, and a judge calls it on the merits. You watch." />
        <ChannelCard Number="1P" Title="1P" Icon="record_voice_over" Href="1p" Cta="Take a side" Accent="ChannelCard.ChannelAccent.P2"
                     Short="You take a seat. A profile takes the other."
                     Description="The same argument, except one side is you. A profile takes the other seat and you speak your turns into the microphone." />
        <ChannelCard Number="2P" Title="2P" Icon="mic" Href="2p" Cta="Both of you" Accent="ChannelCard.ChannelAccent.Accent"
                     Short="Two people, one microphone, a judge between you."
                     Description="Two people, one microphone, no profiles: a judge hosts you, questions you both and rules on who argued better. Your initials keep your record." />
    </div>

    @* One at a time on a phone, side by side above it. Chosen in C# rather than with CSS: rendering both and
       hiding one would put two copies of every replay in the document, which is two of everything for anyone
       reading the page with find-in-page or a screen reader. *@
    @if (Viewport.IsPhone)
    {
        <RadzenTabs @bind-SelectedIndex="_tab" RenderMode="TabRenderMode.Client" class="below-tabs">
            <Tabs>
                <RadzenTabsItem Text="Replays">@Replays</RadzenTabsItem>
                <RadzenTabsItem Text="Top fighters">@Fighters</RadzenTabsItem>
            </Tabs>
        </RadzenTabs>
    }
    else
    {
        <div class="below">
            @Replays
            @Fighters
        </div>
    }
</PageShell>

@code {
    /// <summary>Enough to say what has been happening without turning the home page into the history page.</summary>
    private const int Recent = 4;

    /// <summary>Which of the two lists a phone is looking at.</summary>
    private int _tab;

    /// <summary>
    /// The two sections, written once and placed twice: as tabs on a phone and side by side above 64rem. Two lists
    /// stacked under three channel cards was the last 500 px of home page that would not fit an 844 px screen.
    /// </summary>
    private RenderFragment Replays => @<section class="replays">
            <div class="section-head">
                <h2>Replays</h2>
                <RadzenLink Path="history" Text="All history" Icon="chevron_right" />
            </div>
            @if (_matches.Count == 0)
            {
                <EmptyState Icon="history" Title="No matches yet" Text="Your first watch or fight will show up here with its replay." />
            }
            else
            {
                <ul class="replay-list">
                    @foreach (var match in _matches)
                    {
                        <li>
                            <RadzenLink Path="@Href(match)" class="replay">
                                <ModeBadge Mode="@match.Mode" />
                                <span class="topic">@match.Topic</span>
                                <span class="who po-muted">@match.Side1.DisplayName vs @match.Side2.DisplayName</span>
                                <span class="when po-muted">@match.StartedAt.LocalDateTime.ToString("d MMM", System.Globalization.CultureInfo.CurrentCulture)</span>
                            </RadzenLink>
                        </li>
                    }
                </ul>
            }
        </section>;

    private RenderFragment Fighters => @<section class="fighters">
            <div class="section-head">
                <h2>Top fighters</h2>
                <RadzenLink Path="fighters" Text="All fighters" Icon="chevron_right" />
            </div>
            @if (_fighters.Count == 0)
            {
                <EmptyState Icon="sports_mma" Title="Nobody on the card" Text="Fighters are created the first time their tag steps up to the mic." />
            }
            else
            {
                <ul class="fighter-list">
                    @foreach (var fighter in _fighters)
                    {
                        <li>
                            <RadzenLink Path="@($"fighters/{fighter.Tag}")">
                                <span class="tag po-display">@fighter.Tag</span>
                                <span class="po-muted">@fighter.Wins–@fighter.Losses over @fighter.Fights</span>
                            </RadzenLink>
                        </li>
                    }
                </ul>
            }
        </section>;

    private IReadOnlyList<MatchDto> _matches = [];
    private IReadOnlyList<FighterStatsDto> _fighters = [];

    protected override async Task OnInitializedAsync()
    {
        Viewport.Changed += OnViewportChanged;
        await Viewport.InitializeAsync();

        // Neither list is what the page is for, so neither failure is worth an error: an empty section still reads.
        try
        {
            _matches = [.. (await Api.GetMatchesAsync()).Take(Recent)];
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
        }

        try
        {
            _fighters = [.. (await Api.GetRosterAsync()).Where(f => f.Fights > 0).Take(Recent)];
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
        }
    }

    /// <summary>A fight has a verdict to open; a watch has only its place in the history.</summary>
    private static string Href(MatchDto match) =>
        match.Mode == MatchMode.Fight ? $"verdict/{match.Id.Value}" : $"watch/replay/{match.Id.Value}";

    /// <summary>A rotated phone is a different arrangement of the same two lists.</summary>
    private void OnViewportChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose() => Viewport.Changed -= OnViewportChanged;
}
