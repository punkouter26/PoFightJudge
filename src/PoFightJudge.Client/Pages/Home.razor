@page "/"
@inject TimeProvider Clock
@inject IApiClient Api
@inject Viewport Viewport
@inject SimulationState Simulation
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>PoFightJudge</PageTitle>

<Backdrop Shader="@Shaders.Swarm" />

<PageShell Width="PageShell.ShellWidth.Standard">
    <div class="hero">
        <div class="titles">
            <div class="po-eyebrow">@Clock.GetLocalNow().ToString("dddd · h:mm tt", System.Globalization.CultureInfo.InvariantCulture)</div>
            <h1>What are we fighting about tonight?</h1>
            @* The whole app in one line: what has been argued, who has argued it, and who is waiting to. Each count
               is the way into the page that lists them. *@
            @if (_loaded)
            {
                <p class="tally po-muted">
                    <RadzenLink Path="history" Text="@Tally(_total, "argument")" /> ·
                    <RadzenLink Path="fighters" Text="@Tally(_rosterCount, "fighter")" /> ·
                    <RadzenLink Path="profiles" Text="@($"{StatFormat.Count(_castCount)} in the cast")" />
                </p>
            }
        </div>
        <div class="hero-side">
            <RadzenButton Text="Take the tour" Icon="tour" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small" aria-label="Take the tour"
                          Click="@(() => _tour?.StartAsync() ?? Task.CompletedTask)" />
            <span class="po-chip po-chip--live">Live</span>
        </div>
    </div>

    @* The first visit gets walked round the three channels, and is offered a demo at the end of it. *@
    <CoachMarks @ref="_tour" Steps="@TourSteps">
        <Finale>
            <RadzenButton Text="@(_demoing ? "Starting…" : "Watch a 60-second demo")" Icon="play_circle" ButtonStyle="ButtonStyle.Primary"
                          Size="ButtonSize.Small" Disabled="@_demoing" Click="@DemoAsync" />
        </Finale>
    </CoachMarks>
    @if (_demoProblem is not null)
    {
        <PageAlert Kind="AlertStyle.Warning">@_demoProblem</PageAlert>
    }

    <div class="channels">
        <ChannelCard Number="CPU" Title="CPU vs CPU" Icon="theaters" Href="cpu" Cta="Pick the two" Accent="ChannelCard.ChannelAccent.P1"
                     Description="Two profiles argue; a judge rules. You watch." />
        <ChannelCard Number="1P" Title="1P" Icon="record_voice_over" Href="1p" Cta="Take a side" Accent="ChannelCard.ChannelAccent.P2"
                     Description="You take a seat. A profile takes the other." />
        <ChannelCard Number="2P" Title="2P" Icon="mic" Href="2p" Cta="Both of you" Accent="ChannelCard.ChannelAccent.Accent"
                     Description="Two people, one microphone, a judge between you." />
    </div>

    @* One at a time on a phone, side by side above it. Chosen in C# rather than with CSS: rendering both and
       hiding one would put two copies of every replay in the document, which is two of everything for anyone
       reading the page with find-in-page or a screen reader. *@
    @if (Viewport.IsPhone)
    {
        <RadzenTabs @bind-SelectedIndex="_tab" RenderMode="TabRenderMode.Client" class="below-tabs">
            <Tabs>
                <RadzenTabsItem Text="Recent">@Replays</RadzenTabsItem>
                <RadzenTabsItem Text="Standings">@Fighters</RadzenTabsItem>
            </Tabs>
        </RadzenTabs>
    }
    else
    {
        <div class="below">
            @Replays
            @Fighters
        </div>
    }
</PageShell>

@code {
    /// <summary>Enough to say what has been happening without turning the home page into the history page.</summary>
    private const int Recent = 4;

    /// <summary>Which of the two lists a phone is looking at.</summary>
    private int _tab;

    /// <summary>
    /// The two sections, written once and placed twice: as tabs on a phone and side by side above 64rem. Two lists
    /// stacked under three channel cards was the last 500 px of home page that would not fit an 844 px screen.
    /// </summary>
    private RenderFragment Replays => @<section class="replays">
            <div class="section-head">
                <h2>Recent</h2>
                <RadzenLink Path="history" Text="All history" Icon="chevron_right" />
            </div>
            @* Searched where it stands, on the server: the answer is the newest few that match, not a filter over four. *@
            <div class="recent-find">
                <RadzenTextBox Value="@_find" Change="@FindAsync" Name="recentFind" MaxLength="80" Placeholder="Search a topic or a name"
                               aria-label="Search your arguments" />
            </div>
            @if (!_loaded)
            {
                <LoadingRows Count="3" Table="true" Label="Loading your replays" />
            }
            else if (_matches.Count == 0 && _find.Length > 0)
            {
                <EmptyState Icon="search_off" Title="Nothing matches that" Text="Try another word, or open the full history." />
            }
            else if (_matches.Count == 0)
            {
                <EmptyState Icon="history" Title="No matches yet" Text="Your first watch or fight will show up here with its replay." />
            }
            else
            {
                <ul class="replay-list">
                    @foreach (var match in _matches)
                    {
                        <li>
                            <RadzenLink Path="@Href(match)" class="replay">
                                <ModeBadge Mode="@match.Mode" />
                                <span class="topic">@StatFormat.Topic(match.Topic)</span>
                                <span class="who po-muted">@match.Side1.DisplayName vs @match.Side2.DisplayName</span>
                                <span class="when po-muted">@match.StartedAt.LocalDateTime.ToString("d MMM", System.Globalization.CultureInfo.CurrentCulture)</span>
                            </RadzenLink>
                        </li>
                    }
                </ul>
            }
        </section>;

    private RenderFragment Fighters => @<section class="standings">
            <div class="section-head">
                <h2>Standings</h2>
                <RadzenLink Path="fighters" Text="Leaderboard" Icon="chevron_right" />
            </div>
            @* The same two boards the leaderboard has, the top few of each. *@
            <RadzenSelectBar @bind-Value="_cast" TValue="bool" Size="ButtonSize.Small" aria-label="Whose standings" class="board-switch">
                <Items>
                    <RadzenSelectBarItem Text="Fighters" Value="false" />
                    <RadzenSelectBarItem Text="Cast" Value="true" />
                </Items>
            </RadzenSelectBar>
            @if (!_loaded)
            {
                <LoadingRows Count="3" Table="true" Label="Loading the standings" />
            }
            else if (_cast && _castRows.Count == 0)
            {
                <EmptyState Icon="groups" Title="Nobody ranked yet" Text="A profile is ranked once it has argued twice." />
            }
            else if (_cast)
            {
                <ul class="fighter-list">
                    @foreach (var row in _castRows)
                    {
                        <li>
                            <RadzenLink Path="fighters">
                                <span class="tag po-display">@row.DisplayName</span>
                                <span class="po-muted">@row.Wins of @row.Matches</span>
                            </RadzenLink>
                        </li>
                    }
                </ul>
            }
            else if (_fighters.Count == 0)
            {
                <EmptyState Icon="sports_mma" Title="No judged fights yet" Text="A record starts with the first fight a judge rules on. Rehearsals do not count." />
            }
            else
            {
                <ul class="fighter-list">
                    @foreach (var fighter in _fighters)
                    {
                        <li>
                            <RadzenLink Path="@($"fighters/{fighter.Tag}")">
                                <span class="tag po-display">@fighter.Tag</span>
                                <span class="po-muted">@fighter.Wins–@fighter.Losses over @fighter.Fights</span>
                            </RadzenLink>
                        </li>
                    }
                </ul>
            }
        </section>;

    /// <summary>The tour: one stop per channel, in the order somebody new would want them.</summary>
    private static readonly IReadOnlyList<CoachMarks.Step> TourSteps =
    [
        new("[data-channel='CPU']", "Watch two of them go at it",
            "Pick two personas from your cast and a topic. They argue it out in their own voices, three rounds each, and a judge rules."),
        new("[data-channel='1P']", "Or take a side yourself",
            "The same argument, except one seat is yours. Speak your turns into the microphone, or type them."),
        new("[data-channel='2P']", "Or bring the real argument",
            "Two of you, one microphone. A host runs the show, cuts in when somebody runs long, and rules at the end — then it is all read back, line by line."),
    ];

    private CoachMarks? _tour;
    private bool _demoing;
    private string? _demoProblem;

    /// <summary>
    /// The demo's two: the first husband and the first wife in the cast. Null when either seat cannot be filled.
    /// Public because it is the whole decision.
    /// </summary>
    public static (MatchSide Husband, MatchSide Wife)? DemoPair(IReadOnlyList<ProfileDto> cast)
    {
        var husband = cast.FirstOrDefault(p => p.Persona.Role == ProfileRole.Husband);
        var wife = cast.FirstOrDefault(p => p.Persona.Role == ProfileRole.Wife);
        return husband is null || wife is null ? null : (Side(husband), Side(wife));

        static MatchSide Side(ProfileDto profile) =>
            MatchSide.Persona(profile.Persona.Initials, profile.Persona.Name ?? profile.Persona.Initials);
    }

    /// <summary>
    /// A watch, set up for them: two of the cast on the thermostat. With no cast yet, the default one is loaded first —
    /// a demo that asked them to author two personas before it started would not be a demo.
    /// </summary>
    private async Task DemoAsync()
    {
        _demoing = true;
        _demoProblem = null;
        try
        {
            var cast = await Api.GetProfilesAsync();
            if (DemoPair(cast) is null)
            {
                await Api.SeedProfilesAsync();
                cast = await Api.GetProfilesAsync();
            }

            if (DemoPair(cast) is { } pair)
            {
                Simulation.Set(pair.Husband, pair.Wife, "the thermostat");
                Nav.NavigateTo("watch/play");
                return;
            }

            _demoProblem = "There is nobody in the cast to argue. Add a husband and a wife on the Profiles page.";
        }
        catch (Exception ex) when (ApiFailure.Describe(ex, "The demo could not be set up") is { } why)
        {
            _demoProblem = why;
        }
        finally
        {
            _demoing = false;
        }
    }

    private IReadOnlyList<MatchDto> _matches = [];
    private IReadOnlyList<FighterStatsDto> _fighters = [];
    private IReadOnlyList<LeaderboardRowDto> _castRows = [];

    /// <summary>The counts in the tally under the title.</summary>
    private int _total;
    private int _rosterCount;
    private int _castCount;

    /// <summary>What the recent list is narrowed to; empty for the newest few.</summary>
    private string _find = string.Empty;

    /// <summary>Whether the standings show the cast rather than the fighters.</summary>
    private bool _cast;

    /// <summary>False until both lists have answered, so an empty one is not announced before it is known to be empty.</summary>
    private bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        Viewport.Changed += OnViewportChanged;
        await Viewport.InitializeAsync();

        // Asked for together, and "nothing yet" is only said once all have answered: until then the page does not
        // know, and saying "No matches yet" to somebody with forty of them for half a second is a small lie.
        var matches = Quietly(() => Api.GetMatchPageAsync(new MatchQuery(Take: Recent)), new MatchPageDto([], 0, 0, Recent));
        var roster = Quietly(() => Api.GetRosterAsync(), []);
        var cast = Quietly(() => Api.GetProfilesAsync(), []);
        var castRows = Quietly(() => Api.GetLeaderboardAsync(MatchMode.Watch), []);
        await Task.WhenAll(matches, roster, cast, castRows);

        var page = await matches;
        (_matches, _total) = (page.Matches, page.Total);
        var everyone = await roster;
        (_fighters, _rosterCount) = ([.. everyone.Where(f => f.Fights > 0).Take(Recent)], everyone.Count);
        _castCount = (await cast).Count;
        _castRows = [.. (await castRows).Take(Recent)];
        _loaded = true;
    }

    /// <summary>The newest few that have what was typed in their topic or names, asked of the server.</summary>
    private async Task FindAsync(string? text)
    {
        _find = text?.Trim() ?? string.Empty;
        var page = await Quietly(
            () => Api.GetMatchPageAsync(new MatchQuery(Text: _find.Length > 0 ? _find : null, Take: Recent)),
            new MatchPageDto([], 0, 0, Recent));
        _matches = page.Matches;
    }

    // Nothing here is what the page is for, so no failure is worth an error: an empty section still reads.
    private static async Task<T> Quietly<T>(Func<Task<T>> read, T otherwise)
    {
        try
        {
            return await read();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            return otherwise;
        }
    }

    /// <summary>"1 argument", "23 arguments".</summary>
    private static string Tally(int count, string noun) => $"{StatFormat.Count(count)} {noun}{(count == 1 ? string.Empty : "s")}";

    /// <summary>A fight has a verdict to open; a watch has only its place in the history.</summary>
    private static string Href(MatchDto match) =>
        match.Mode == MatchMode.Fight ? $"verdict/{match.Id.Value}" : $"watch/replay/{match.Id.Value}";

    /// <summary>A rotated phone is a different arrangement of the same two lists.</summary>
    private void OnViewportChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose() => Viewport.Changed -= OnViewportChanged;
}
