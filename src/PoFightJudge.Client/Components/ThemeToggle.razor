@inject ThemeInterop Theme

<RadzenButton class="po-theme-toggle"
              ButtonStyle="ButtonStyle.Base"
              Variant="Variant.Text"
              Size="ButtonSize.Medium"
              Icon="@(Theme.IsDark ? "light_mode" : "dark_mode")"
              Click="ToggleAsync"
              aria-pressed="@(Theme.IsDark ? "false" : "true")"
              aria-label="@($"Switch to {(Theme.IsDark ? "light" : "dark")} theme")"
              title="Theme" />

@code {
    protected override async Task OnInitializedAsync() => await Theme.InitializeAsync();

    private async Task ToggleAsync()
    {
        await Theme.ToggleAsync();
        StateHasChanged();
    }
}
