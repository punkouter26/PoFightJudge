@inject IApiClient Api

@if (_show)
{
    <div class="po-fake-banner" role="status" aria-live="polite">
        <RadzenIcon Icon="science" />
        <span>Using fake AI — no Gemini key configured. Matches are exhibitions.</span>
    </div>
}

@code {
    private bool _show;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Through the typed client: the banner renders on the sign-in page, before there is a token, and the
            // feature-flag call is the one that travels on the anonymous HttpClient.
            var flags = await Api.GetFeaturesAsync();
            _show = flags.UseFakeAi;
        }
        catch (HttpRequestException)
        {
            // The API is down; the pages will say so in their own words.
        }
    }
}
