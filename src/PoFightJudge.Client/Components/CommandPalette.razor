@using Toolbelt.Blazor.HotKeys2
@implements IAsyncDisposable
@inject IApiClient Api
@inject NavigationManager Nav
@inject HotKeys HotKeys

@* Ctrl+K anywhere. Nothing is rendered until it is opened, so the shortcut costs a listener and no markup. *@
@if (_open)
{
    <div class="scrim" @onclick="Close">
        <div class="palette po-card" role="dialog" aria-modal="true" aria-label="Go to" @onclick:stopPropagation="true">
            <RadzenTextBox @ref="_box" Value="@_query" @oninput="@OnTyped" @onkeydown="@OnKeyDown" Name="palette"
                           Placeholder="Where to?" aria-label="Search for somewhere to go" class="query" autocomplete="off" />

            @if (Matches.Count == 0)
            {
                <p class="po-muted none">Nothing here by that name.</p>
            }
            else
            {
                <ul class="results" role="listbox" aria-label="Matches">
                    @foreach (var (command, index) in Matches.Select((c, i) => (c, i)))
                    {
                        <li role="option" aria-selected="@(index == _selected)">
                            <RadzenButton Icon="@command.Icon" Text="@command.Label" ButtonStyle="ButtonStyle.Base"
                                          Variant="@(index == _selected ? Variant.Filled : Variant.Text)"
                                          class="result" Click="@(() => Run(command))" />
                            @if (command.Hint is { Length: > 0 } hint)
                            {
                                <span class="po-muted hint">@hint</span>
                            }
                        </li>
                    }
                </ul>
            }

            <p class="po-muted keys">Up and down to move · Enter to go · Esc to close</p>
        </div>
    </div>
}

@code {
    /// <summary>How many matches are shown. A palette that fills the screen is a list, not a shortcut.</summary>
    public const int MaxResults = 8;

    private readonly List<Command> _commands = [];
    private HotKeysContext? _keys;
    private RadzenTextBox? _box;
    private bool _open;
    private bool _loaded;
    private string _query = string.Empty;
    private int _selected;

    /// <summary>Somewhere to go, and what to call it. Everything in the palette is a navigation.</summary>
    private sealed record Command(string Label, string Icon, string Path, string Hint = "");

    private IReadOnlyList<Command> Matches
    {
        get
        {
            var query = _query.Trim();
            var matching = query.Length == 0
                ? _commands
                : _commands.Where(c =>
                    c.Label.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                    c.Hint.Contains(query, StringComparison.OrdinalIgnoreCase));

            return [.. matching.Take(MaxResults)];
        }
    }

    protected override void OnInitialized()
    {
        _commands.AddRange(Places);

        // Ctrl+K is not excluded from text boxes: the palette's own box is one, and so is half the app.
        _keys = HotKeys.CreateContext()
            .Add(ModCode.Ctrl, Code.K, ToggleAsync, new() { Description = "Go to…", Exclude = Exclude.None, PreventDefault = true })
            .Add(Code.Escape, CloseIfOpen, new() { Description = "Close the palette", Exclude = Exclude.None });
    }

    /// <summary>The fixed destinations. The same list the top bar has, plus the places it has no room for.</summary>
    private static IEnumerable<Command> Places =>
    [
        new("Home", "home", ""),
        new("CPU vs CPU", "theaters", "cpu", "watch two profiles argue"),
        new("1P", "record_voice_over", "1p", "take a side yourself"),
        new("2P", "mic", "2p", "two people, one microphone"),
        new("Profiles", "groups", "profiles", "the cast"),
        new("Fighters", "person", "fighters", "everyone who has argued"),
        new("History", "history", "history", "every argument"),
        new("Leaderboard", "leaderboard", "leaderboard"),
        new("Health", "monitor_heart", "health", "what is up and what is not"),
    ];

    private async ValueTask ToggleAsync()
    {
        _open = !_open;
        if (!_open)
        {
            return;
        }

        _query = string.Empty;
        _selected = 0;
        await LoadPeopleAsync();
        StateHasChanged();

        // After the render that puts it on screen, or there is nothing to focus yet.
        await Task.Yield();
        if (_box is not null)
        {
            await _box.FocusAsync();
        }
    }

    /// <summary>
    /// Everyone who has argued, added once per session. A roster read on every open would put a request behind a
    /// keystroke, and the roster does not change while somebody is looking for the History page.
    /// </summary>
    private async Task LoadPeopleAsync()
    {
        if (_loaded)
        {
            return;
        }

        _loaded = true;
        try
        {
            foreach (var fighter in await Api.GetFightersAsync())
            {
                _commands.Add(new(fighter.DisplayName, "person", $"fighters/{fighter.Tag}", $"{fighter.Tag} · their record"));
            }
        }
        catch (ApiException)
        {
            // Signed out, or the API is unhappy. The fixed destinations still work.
        }
        catch (HttpRequestException)
        {
        }
    }

    private ValueTask CloseIfOpen()
    {
        if (_open)
        {
            Close();
        }

        return ValueTask.CompletedTask;
    }

    private void Close()
    {
        _open = false;
        StateHasChanged();
    }

    private void OnTyped(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? string.Empty;
        _selected = 0;
    }

    /// <summary>
    /// Arrows and Enter are handled on the box rather than as hot keys: they belong to the palette while it is open
    /// and to the page the rest of the time, and a global Enter would fire every form on the site.
    /// </summary>
    private void OnKeyDown(KeyboardEventArgs e)
    {
        var matches = Matches;
        switch (e.Key)
        {
            case "ArrowDown":
                _selected = matches.Count == 0 ? 0 : (_selected + 1) % matches.Count;
                break;
            case "ArrowUp":
                _selected = matches.Count == 0 ? 0 : (_selected - 1 + matches.Count) % matches.Count;
                break;
            case "Enter" when _selected < matches.Count:
                Run(matches[_selected]);
                break;
            case "Escape":
                Close();
                break;
            default:
                break;
        }
    }

    private void Run(Command command)
    {
        _open = false;
        Nav.NavigateTo(command.Path);
    }

    public async ValueTask DisposeAsync()
    {
        if (_keys is not null)
        {
            await _keys.DisposeAsync();
            _keys = null;
        }
    }
}
