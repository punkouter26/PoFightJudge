@* T112: the lightning rod above the topic field. The arc grows with the topic's length, and a bolt
   fires when it crosses the six-character threshold. The arc is a small inline SVG so it inherits the
   design tokens and prints correctly without a runtime fetch. *@

<svg class="topic-thread" role="presentation" aria-hidden="true" viewBox="0 0 400 100" preserveAspectRatio="none">
    <path data-topic-thread-path class="thread-path"
          d="M0 100" fill="none" stroke="var(--po-accent)" stroke-width="2" stroke-linecap="round" />
    <path data-topic-thread-bolt class="thread-bolt"
          d="M180 30 L170 60 L190 50 L175 90 L210 50 L195 55 L210 30 Z"
          fill="var(--po-warning)" opacity="0" />
</svg>

@code {
    /// <summary>Selector that locates the host element. Lets the page put the thread anywhere relative to the field.</summary>
    [Parameter] public string HostSelector { get; set; } = ".topic";

    /// <summary>The topic as it has been typed so far; passed to the JS observer to size the arc.</summary>
    [Parameter] public string Topic { get; set; } = string.Empty;

    [Inject] private IJSRuntime Js { get; set; } = default!;

    /// <summary>Tells the JS observer to redraw the arc every time the topic changes.</summary>
    protected override async Task OnParametersSetAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("PoTopicThread.update", HostSelector, Topic ?? string.Empty);
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
        catch (TaskCanceledException)
        {
        }
    }
}
