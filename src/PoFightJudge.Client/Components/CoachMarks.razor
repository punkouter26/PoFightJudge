@using System.Globalization
@using Blazored.LocalStorage
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILocalStorageService Storage
@* A first visit's tour: one thing on the page at a time lifted into a spotlight (PoFx.spot), a bubble beside it saying
   what it is, and Next until there is nothing left. Done or skipped, it is remembered and not shown again. *@

@if (_step is { } step && _box is { } box)
{
    <section class="coach" role="dialog" aria-labelledby="coach-title" style="@Place(box)">
        <span class="po-eyebrow">@(step + 1) of @Steps.Count</span>
        <h2 id="coach-title" class="po-display">@Steps[step].Title</h2>
        <p>@Steps[step].Text</p>
        <div class="ways">
            <RadzenButton Text="Skip the tour" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small" Click="@FinishAsync" />
            @if (step < Steps.Count - 1)
            {
                <RadzenButton Text="Next" Icon="arrow_forward" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@NextAsync" />
            }
            else
            {
                @Finale
                <RadzenButton Text="Done" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="@FinishAsync" />
            }
        </div>
    </section>
}

@code {
    private const string Done = "done";

    /// <summary>One stop on the tour: what to point at, and what to say about it.</summary>
    public sealed record Step(string Selector, string Title, string Text);

    /// <summary>Where the thing pointed at is on screen, and how big the screen is, as PoFx.spot measures them.</summary>
    public sealed record SpotBox(double Top, double Left, double Width, double Height, double ViewWidth, double ViewHeight);

    [Parameter, EditorRequired] public IReadOnlyList<Step> Steps { get; set; } = [];

    /// <summary>Where "seen it" is kept. One key per tour.</summary>
    [Parameter] public string StorageKey { get; set; } = "po-tour";

    /// <summary>What the last stop offers beside Done — a way to try the thing that was just shown.</summary>
    [Parameter] public RenderFragment? Finale { get; set; }

    private int? _step;
    private SpotBox? _box;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var seen = await Storage.GetItemAsStringAsync(StorageKey);
            if (string.Equals(seen?.Trim('"'), Done, StringComparison.Ordinal))
            {
                return;
            }
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
            // Storage blocked: a tour that could never be remembered as done would greet them every time. None at all.
            return;
        }

        await ShowAsync(0);
    }

    /// <summary>From the top again, for somebody who asked to see it.</summary>
    public Task StartAsync() => InvokeAsync(() => ShowAsync(0));

    /// <summary>The first stop from <paramref name="from"/> whose target is on the page. A tour with none left is over.</summary>
    private async Task ShowAsync(int from)
    {
        for (var step = from; step < Steps.Count; step++)
        {
            if (await SpotAsync(Steps[step].Selector) is { } box)
            {
                (_step, _box) = (step, box);
                StateHasChanged();
                return;
            }
        }

        await FinishAsync();
    }

    private Task NextAsync() => ShowAsync((_step ?? -1) + 1);

    private async Task FinishAsync()
    {
        (_step, _box) = (null, null);
        await SpotAsync(null);
        try
        {
            await Storage.SetItemAsStringAsync(StorageKey, Done);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
            // Not remembered; it will be offered again next time, which is the lesser nuisance.
        }

        StateHasChanged();
    }

    private async Task<SpotBox?> SpotAsync(string? selector)
    {
        try
        {
            return await JS.InvokeAsync<SpotBox?>("PoFx.spot", selector);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException)
        {
            return null;
        }
    }

    /// <summary>The bubble: under what it points at when there is room, over it when there is not, and never off the side.</summary>
    private static string Place(SpotBox box)
    {
        const double Width = 352;
        const double Tall = 220;
        const double Gap = 14;
        var left = Math.Clamp(box.Left, 16, Math.Max(16, box.ViewWidth - Width - 16));
        var below = box.Top + box.Height + Gap;
        var top = below + Tall > box.ViewHeight ? Math.Max(16, box.Top - Gap - Tall) : below;
        return string.Create(CultureInfo.InvariantCulture, $"top: {top:0}px; left: {left:0}px;");
    }

    public async ValueTask DisposeAsync()
    {
        if (_step is not null)
        {
            await SpotAsync(null);
        }
    }
}
