@using System.Text.Json
@using FluentValidation
@using Humanizer
@using Blazored.FluentValidation
@using PoFightJudge.Shared.Validators
@inject IApiClient Api
@inject FeatureGate Features
@inject DialogService Dialog

@* Create or edit a persona. Hosted by DialogService (the page awaits the saved ProfileDto) and rendered on its own in
   tests. The form edits a copy; the list only changes when the server has accepted it. *@
<RadzenTemplateForm TItem="CreateProfileRequest" Data="@_model" Submit="@SaveAsync" class="editor">
    <FluentValidationValidator DisableAssemblyScanning="true" />

    @if (!IsEdit)
    {
        <div class="generate">
            <RadzenButton Text="Generate with AI" Icon="auto_awesome" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined"
                          Click="@GenerateAsync" IsBusy="@_generating" BusyText="Inventing…" Disabled="@_busy" />
            @if (_generating)
            {
                <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
            }
            <span class="po-muted hint">Invents a persona for the selected role. Review it, tweak it, then create.</span>
        </div>
    }

    @if (Existing?.FromFights == true)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="from-fights">
            This persona is read from what @Existing.Persona.Initials has actually said, in every debate they have argued in, and is rewritten after each one. Anything you change here lasts until their next debate.
        </RadzenAlert>
    }

    <RadzenFieldset Text="Identity" class="section">
        <div class="identity">
            <div class="portrait">
                @if (_faceDataUrl is not null)
                {
                    <RadzenImage Path="@_faceDataUrl" AlternateText="New portrait" class="face" />
                }
                else if (Existing is { HasFace: true })
                {
                    <RadzenImage Path="@ApiRoutes.Profiles.Face(Existing.Id)" AlternateText="@_model.Initials" class="face" />
                }
                else
                {
                    <div class="face face--blank po-display" aria-hidden="true">@(string.IsNullOrWhiteSpace(_model.Initials) ? "?" : _model.Initials.ToUpperInvariant())</div>
                }
                <RadzenFileInput TValue="string" @bind-Value="_faceDataUrl" Accept="image/*" MaxFileSize="@MaxFaceBytes"
                                 ChooseText="Upload portrait" DeleteText="Clear" Error="@OnFaceError" class="face-input" />
                <span class="po-muted hint">Any image up to 4 MB; it is cropped to a square.</span>
            </div>
            <div class="fields">
                <RadzenFormField Text="Initials" Variant="Variant.Outlined">
                    <ChildContent>
                        <RadzenTextBox @bind-Value="_model.Initials" Name="Initials" MaxLength="@Initials.MaxLength" Disabled="@IsEdit" />
                    </ChildContent>
                    <Helper><ValidationMessage For="@(() => _model.Initials)" /></Helper>
                </RadzenFormField>
                <RadzenFormField Text="Role" Variant="Variant.Outlined">
                    <ChildContent>
                        <RadzenDropDown TValue="ProfileRole" @bind-Value="_model.Role" Data="@Roles" ValueProperty="Value" TextProperty="Text" Name="Role" />
                    </ChildContent>
                </RadzenFormField>
                <RadzenFormField Text="Name" Variant="Variant.Outlined" class="span-2">
                    <ChildContent>
                        <RadzenTextBox @bind-Value="_model.Name" Name="Name" MaxLength="@CreateProfileRequestValidator.MaxNameLength" />
                    </ChildContent>
                    <Helper><ValidationMessage For="@(() => _model.Name)" /></Helper>
                </RadzenFormField>
                <RadzenFormField Text="Age" Variant="Variant.Outlined">
                    <ChildContent>
                        <RadzenNumeric TValue="int?" @bind-Value="_model.Age" Min="@CreateProfileRequestValidator.MinAge" Max="@CreateProfileRequestValidator.MaxAge" Name="Age" />
                    </ChildContent>
                    <Helper><ValidationMessage For="@(() => _model.Age)" /></Helper>
                </RadzenFormField>
                <RadzenFormField Text="Occupation" Variant="Variant.Outlined">
                    <ChildContent>
                        <RadzenTextBox @bind-Value="_model.Occupation" Name="Occupation" MaxLength="@CreateProfileRequestValidator.MaxOccupationLength" />
                    </ChildContent>
                    <Helper><ValidationMessage For="@(() => _model.Occupation)" /></Helper>
                </RadzenFormField>
            </div>
        </div>
    </RadzenFieldset>

    <RadzenFieldset Text="What they argue about" class="section">
        <div class="bio">
            <RadzenFormField Text="Likes" Variant="Variant.Outlined">
                <ChildContent><RadzenTextArea @bind-Value="_model.Likes" Name="Likes" Rows="2" MaxLength="@CreateProfileRequestValidator.MaxTextLength" /></ChildContent>
                <Helper><ValidationMessage For="@(() => _model.Likes)" /></Helper>
            </RadzenFormField>
            <RadzenFormField Text="Dislikes" Variant="Variant.Outlined">
                <ChildContent><RadzenTextArea @bind-Value="_model.Dislikes" Name="Dislikes" Rows="2" MaxLength="@CreateProfileRequestValidator.MaxTextLength" /></ChildContent>
                <Helper><ValidationMessage For="@(() => _model.Dislikes)" /></Helper>
            </RadzenFormField>
            <RadzenFormField Text="Common arguments" Variant="Variant.Outlined">
                <ChildContent><RadzenTextArea @bind-Value="_model.CommonArguments" Name="CommonArguments" Rows="2" MaxLength="@CreateProfileRequestValidator.MaxTextLength" /></ChildContent>
                <Helper><ValidationMessage For="@(() => _model.CommonArguments)" /></Helper>
            </RadzenFormField>
            <RadzenFormField Text="Philosophy" Variant="Variant.Outlined">
                <ChildContent><RadzenTextArea @bind-Value="_model.Philosophy" Name="Philosophy" Rows="2" MaxLength="@CreateProfileRequestValidator.MaxTextLength" /></ChildContent>
                <Helper><ValidationMessage For="@(() => _model.Philosophy)" /></Helper>
            </RadzenFormField>
        </div>
    </RadzenFieldset>

    @* Four dials, not nine. These change how an argument is conducted; the ones that went were about what it is
       about, which is what the free text above already says, and in somebody's own words. *@
    <RadzenFieldset Text="How they argue" class="section">
        <div class="sliders">
            @foreach (var slider in Sliders)
            {
                <div class="slider">
                    <div class="slider-head">
                        <span>@slider.Left</span>
                        <span class="po-num">@slider.Get()</span>
                        <span>@slider.Right</span>
                    </div>
                    <RadzenSlider TValue="int" Min="0" Max="100" Value="@slider.Get()" Change="@(v => slider.Set(v))" aria-label="@($"{slider.Left} to {slider.Right}")" />
                </div>
            }
        </div>
    </RadzenFieldset>

    @* Two ways to have a voice, and only ever one of them on screen. With Fish Audio configured a persona speaks in
       a cloned voice named by its reference id, and Gemini's own voice and prosody do not apply to it; without a
       Fish key there is nothing a reference id could be sent to, so asking for one would be asking for nothing. *@
    @if (Features.Flags.FishVoices)
    {
        <RadzenFieldset Text="Voice" class="section">
            <div class="voice">
                <RadzenFormField Text="Fish voice id" Variant="Variant.Outlined" class="span-2">
                    <ChildContent>
                        <RadzenTextBox @bind-Value="_model.TtsSettings.FishReferenceId" Name="FishReferenceId" MaxLength="128"
                                       Placeholder="e.g. trump" aria-label="Fish Audio voice id" />
                    </ChildContent>
                    <Helper>
                        <span class="po-muted">The id from the voice's fish.audio/m/&#123;id&#125; page. Leave it empty and this persona is spoken by the ordinary voice.</span>
                        <ValidationMessage For="@(() => _model.TtsSettings.FishReferenceId)" />
                    </Helper>
                </RadzenFormField>
            </div>
        </RadzenFieldset>
    }
    else
    {
        <RadzenFieldset Text="Voice" class="section">
            <div class="voice">
                <RadzenFormField Text="Gemini voice" Variant="Variant.Outlined">
                    <ChildContent>
                        <RadzenDropDown TValue="string" @bind-Value="_model.TtsSettings.VoiceName" Data="@VoicesFor(_model.Role)" Name="VoiceName" />
                    </ChildContent>
                    <Helper><ValidationMessage For="@(() => _model.TtsSettings.VoiceName)" /></Helper>
                </RadzenFormField>
                <div class="slider">
                    <div class="slider-head"><span>Pitch</span><span class="po-num">@_model.TtsSettings.Pitch.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</span><span></span></div>
                    <RadzenSlider TValue="double" Min="@((decimal)CreateProfileRequestValidator.MinProsody)" Max="@((decimal)CreateProfileRequestValidator.MaxProsody)" Step="0.05" @bind-Value="_model.TtsSettings.Pitch" aria-label="Pitch" />
                </div>
                <div class="slider">
                    <div class="slider-head"><span>Speed</span><span class="po-num">@_model.TtsSettings.Speed.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</span><span></span></div>
                    <RadzenSlider TValue="double" Min="@((decimal)CreateProfileRequestValidator.MinProsody)" Max="@((decimal)CreateProfileRequestValidator.MaxProsody)" Step="0.05" @bind-Value="_model.TtsSettings.Speed" aria-label="Speed" />
                </div>
            </div>
        </RadzenFieldset>
    }

    @if (_error is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="error">@_error</RadzenAlert>
    }

    <div class="footer">
        <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Click="@(() => Dialog.Close(null))" Disabled="@_busy" />
        <RadzenButton ButtonType="ButtonType.Submit" Text="@(IsEdit ? "Save changes" : "Create profile")" Icon="check" ButtonStyle="ButtonStyle.Primary" IsBusy="@_busy" BusyText="Saving…" />
    </div>
</RadzenTemplateForm>

@code {
    /// <summary>Largest portrait the picker accepts; the server enforces the same cap.</summary>
    public const int MaxFaceBytes = 4 * 1024 * 1024;

    private static readonly JsonSerializerOptions CloneOptions = new(JsonSerializerDefaults.Web);

    private static readonly string[] HusbandVoices = ["Charon", "Puck", "Fenrir"];
    private static readonly string[] WifeVoices = ["Kore", "Zephyr"];

    /// <summary>The persona being edited; null creates a new one.</summary>
    [Parameter] public ProfileDto? Existing { get; set; }

    /// <summary>Starting values for a new persona (a generated one, a duplicate…); ignored when <see cref="Existing"/> is set.</summary>
    [Parameter] public CreateProfileRequest? Template { get; set; }

    /// <summary>Raised with the server's copy after a successful save (and portrait upload, if one was picked).</summary>
    [Parameter] public EventCallback<ProfileDto> OnSaved { get; set; }

    private CreateProfileRequest _model = new();
    private bool _initialized;
    private string? _faceDataUrl;
    private string? _error;
    private bool _busy;
    private bool _generating;

    private bool IsEdit => Existing is not null;

    private sealed record Option<T>(T Value, string Text);

    private static IReadOnlyList<Option<T>> OptionsOf<T>()
        where T : struct, Enum =>
        [.. Enum.GetValues<T>().Select(v => new Option<T>(v, v.Humanize(LetterCasing.Sentence)))];

    private static readonly IReadOnlyList<Option<ProfileRole>> Roles = OptionsOf<ProfileRole>();

    private static IEnumerable<string> VoicesFor(ProfileRole role) => role == ProfileRole.Wife ? WifeVoices : HusbandVoices;

    private sealed record Slider(string Left, string Right, Func<int> Get, Action<int> Set);

    private IReadOnlyList<Slider> Sliders =>
    [
        new("Logic", "Emotion", () => _model.LogicVsEmotion, v => _model.LogicVsEmotion = v),
        new("Impatient", "Patient", () => _model.Patience, v => _model.Patience = v),
        new("Forgiving", "Holds grudges", () => _model.HoldsGrudges, v => _model.HoldsGrudges = v),
        new("Secure", "Jealous", () => _model.Jealousy, v => _model.Jealousy = v),
    ];

    protected override void OnParametersSet()
    {
        if (_initialized)
        {
            return;
        }

        _initialized = true;
        _model = Existing is not null ? Clone(Existing.Persona) : Template is not null ? Clone(Template) : new CreateProfileRequest();
        if (!VoicesFor(_model.Role).Contains(_model.TtsSettings.VoiceName, StringComparer.Ordinal))
        {
            _model.TtsSettings.VoiceName = VoicesFor(_model.Role).First();
        }
    }

    private static CreateProfileRequest Clone(CreateProfileRequest source) =>
        JsonSerializer.Deserialize<CreateProfileRequest>(JsonSerializer.Serialize(source, CloneOptions), CloneOptions)!;

    private void OnFaceError(UploadErrorEventArgs args) => _error = "That image is too large — pick one under 4 MB.";

    private async Task GenerateAsync()
    {
        _generating = true;
        _error = null;
        try
        {
            var draft = await Api.GenerateProfileAsync(_model.Role);
            draft.TtsSettings ??= new TtsSettingsDto();
            _model = draft;
        }
        catch (ApiException ex)
        {
            _error = ex.Summary;
        }
        catch (HttpRequestException ex)
        {
            _error = $"The API is not answering ({ex.Message}).";
        }
        finally
        {
            _generating = false;
        }
    }

    private async Task SaveAsync(CreateProfileRequest model)
    {
        _busy = true;
        _error = null;
        try
        {
            var saved = IsEdit ? await Api.UpdateProfileAsync(Existing!.Id, model) : await Api.CreateProfileAsync(model);
            if (TryParseDataUrl(_faceDataUrl, out var bytes, out var contentType))
            {
                saved = await Api.UploadFaceAsync(saved.Id, bytes, contentType);
            }

            await OnSaved.InvokeAsync(saved);
            Dialog.Close(saved);
        }
        catch (ApiException ex)
        {
            _error = ex.Summary;
        }
        catch (HttpRequestException ex)
        {
            _error = $"The API is not answering ({ex.Message}).";
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>RadzenFileInput hands over a data: URL; the API wants the bytes and their type.</summary>
    internal static bool TryParseDataUrl(string? dataUrl, out byte[] bytes, out string contentType)
    {
        bytes = [];
        contentType = string.Empty;
        if (dataUrl is null || !dataUrl.StartsWith("data:", StringComparison.Ordinal))
        {
            return false;
        }

        var comma = dataUrl.IndexOf(',', StringComparison.Ordinal);
        if (comma < 0)
        {
            return false;
        }

        var meta = dataUrl[5..comma];
        var semicolon = meta.IndexOf(';', StringComparison.Ordinal);
        contentType = semicolon >= 0 ? meta[..semicolon] : meta;
        try
        {
            bytes = Convert.FromBase64String(dataUrl[(comma + 1)..]);
        }
        catch (FormatException)
        {
            return false;
        }

        return bytes.Length > 0 && contentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);
    }
}
