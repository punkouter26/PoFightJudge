@* T111: the wax seal on a fallacy. A small SVG stamp that drops in from above, ink-wobbles, and stays
   tilted on the corner of the quote. The seal is drawn inline so it inherits the design tokens and prints
   correctly without a runtime fetch. The thump is fired from JS via a tiny module so the audio and the
   animation land on the same frame. *@

@if (Stamp is not null)
{
    <svg class="fallacy-stamp" role="img" aria-label="A seal marks this as a @Stamp"
         viewBox="0 0 100 100" width="44" height="44" data-fallacy="@Stamp">
        <defs>
            <filter id="ink-rough" x="-10%" y="-10%" width="120%" height="120%">
                <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="3" />
                <feDisplacementMap in="SourceGraphic" scale="1.6" />
            </filter>
        </defs>
        <g filter="url(#ink-rough)">
            <circle cx="30" cy="30" r="22" fill="var(--po-warning)" />
            <circle cx="30" cy="30" r="22" fill="none" stroke="var(--po-warning-ink, var(--po-surface-0))" stroke-width="2" stroke-dasharray="3 2" />
            <text x="30" y="34" text-anchor="middle" font-family="Barlow Condensed, sans-serif" font-weight="700"
                  font-size="11" fill="var(--po-surface-0)">FALLACY</text>
        </g>
    </svg>
}

@code {
    [Parameter] public string? Stamp { get; set; }
}
